 const stores=()=>{const h=$('#dmst');if(!h)return;let o='';
  CP.slice().sort((a,b)=>(a.S===b.S?b.z0-a.z0:0)).forEach(c=>{const g=c.g,col=c.S.c,O=op.has(c.id),mid=(a,b,t)=>[a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t];
   if(!O){o+=`<polygon class="dmd" data-c="${c.id}" points="${f2(g.front)}" fill="${dSh(col,c.t==='door'?.96:.92)}" stroke="${dSh(col,.55)}" stroke-width=".9" stroke-linejoin="round"/>`;
    if(c.t==='door'){const e=c.hg==='l'?mid(g.front[1],g.front[2],.5):mid(g.front[0],g.front[3],.5),q=mid(e,c.hg==='l'?mid(g.front[0],g.front[3],.5):mid(g.front[1],g.front[2],.5),.14);o+=knob(q,col)}
    else{const a=mid(mid(g.front[0],g.front[3],.5),mid(g.front[1],g.front[2],.5),.4),b=mid(mid(g.front[0],g.front[3],.5),mid(g.front[1],g.front[2],.5),.6);o+=`<line x1="${a[0].toFixed(1)}" y1="${a[1].toFixed(1)}" x2="${b[0].toFixed(1)}" y2="${b[1].toFixed(1)}" stroke="#e8d9a8" stroke-width="1.8" stroke-linecap="round"/>`}
    return}
   const its=inC(c.id).map(q=>sp(q[0],q[1],q[2],q[3],(q[4]?'pop ':'')+(bad.has(q[0])?'bad':''),csz(c))).join('');
   if(c.t==='door'){o+=`<polygon points="${f2(g.front)}" fill="#3b2a20" stroke="${dSh(col,.5)}" stroke-width=".9"/>`;
    const a=mid(g.front[3],g.front[2],0),b=mid(g.front[3],g.front[2],1),t1=mid(mid(g.front[0],g.front[3],.88),mid(g.front[1],g.front[2],.88),0),t2=mid(mid(g.front[0],g.front[3],.88),mid(g.front[1],g.front[2],.88),1);
    o+=c.k==='wardrobe'?`<line x1="${t1[0].toFixed(1)}" y1="${t1[1].toFixed(1)}" x2="${t2[0].toFixed(1)}" y2="${t2[1].toFixed(1)}" stroke="#b9c3d2" stroke-width="1.6"/>`:`<polygon points="${f2([mid(g.front[0],g.front[3],.5),mid(g.front[1],g.front[2],.5),mid(g.front[1],g.front[2],.54),mid(g.front[0],g.front[3],.54)])}" fill="#6b4c38"/>`;
    o+=its+`<polygon class="dmd o" data-c="${c.id}" points="${f2(g.panel)}" fill="${dSh(col,1.05)}" stroke="${dSh(col,.55)}" stroke-width=".9" stroke-linejoin="round"/>`}
   else{o+=`<polygon points="${f2(g.front)}" fill="#2e2018"/><polygon points="${f2(g.sl)}" fill="${dSh(col,.7)}" stroke="${dSh(col,.5)}" stroke-width=".6"/><polygon points="${f2(g.floor)}" fill="#5a4030" stroke="${dSh(col,.5)}" stroke-width=".6"/>`+its+`<polygon points="${f2(g.sr)}" fill="${dSh(col,.8)}" stroke="${dSh(col,.5)}" stroke-width=".6"/><polygon class="dmd o" data-c="${c.id}" points="${f2(g.fr)}" fill="${dSh(col,.95)}" stroke="${dSh(col,.55)}" stroke-width=".9" stroke-linejoin="round"/>`;
    const m1=mid(mid(g.fr[0],g.fr[3],.5),mid(g.fr[1],g.fr[2],.5),.4),m2=mid(mid(g.fr[0],g.fr[3],.5),mid(g.fr[1],g.fr[2],.5),.6);o+=`<line x1="${m1[0].toFixed(1)}" y1="${m1[1].toFixed(1)}" x2="${m2[0].toFixed(1)}" y2="${m2[1].toFixed(1)}" stroke="#e8d9a8" stroke-width="1.8" stroke-linecap="round"/>`}
  });h.innerHTML=o};
 /* quel compartiment sous le doigt ? */
 const cAt=pt=>{for(const c of CP.slice().reverse()){const g=c.g,O=op.has(c.id);if(O&&dIn(pt,g.panel))return{c,panel:1};if(O&&dIn(pt,g.zone))return{c,inside:1};if(!O&&dIn(pt,g.front))return{c,closed:1}}return null};
 const toggle=(c,v)=>{if(v)op.add(c.id);else op.delete(c.id);sfx(v?420:330,.18);vib(6);stores();layer();sv()};act.dmx=()=>{const d=$('#dmo');if(d)d.remove()};
 const left=()=>ids.filter(id=>!placed.some(q=>q[0]===id));
 const sp=(id,x,y,c,cls='',z=27)=>`<svg class="dmp ${cls}" data-id="${id}" x="${(x-z/2).toFixed(1)}" y="${(y-(c==='c'?z/2:z*.937)).toFixed(1)}" width="${z}" height="${z}" viewBox="0 0 32 32"><title>${DIT[id][0]}</title>${DIT[id][1]}</svg>`;
 const layer=()=>{const rr=$('#dmr');if(rr)rr.classList.toggle('hb',bad.size>0);stores();const g=$('#dml');if(g)g.innerHTML=placed.filter(q=>!q[6]).sort((a,b)=>a[2]-b[2]).map(q=>sp(q[0],q[1],q[2],q[3],(q[4]?'pop':'')+(bad.has(q[0])?' bad':''))).join('')};
 const tray=()=>{const t=$('#dmt'),n=left();if(!t)return;const K=Math.max(3,Math.floor(((t.clientWidth||320)-12+6)/62)),vis=n.slice(0,K);if(selId&&!vis.includes(selId))selId=null;t.innerHTML=vis.map(id=>`<button class="dmi${selId===id?' sel':''}" data-id="${id}" aria-label="${DIT[id][0]}"><span>${dSpr(id,32)}</span><small>${DIT[id][0]}</small></button>`).join('')||(bad.size?'<p class="note" style="margin:0;text-align:center">Touche un objet en surbrillance pour le reprendre et le ranger au bon endroit.</p>':'<p class="note" style="margin:0;text-align:center">La boîte est vide.</p>');const c=$('#dmn');if(c)c.textContent=n.length?n.length+' objet'+(n.length>1?'s':'')+' à ranger':bad.size?bad.size+' objet'+(bad.size>1?'s':'')+' à replacer':'Boîte vide ✓'};
 frame(`<div class="dm"><p class="lit">${X?'Fêtes · ':R.h+' · '}${R.n}</p><div class="dmw"><svg id="dmr" viewBox="0 0 ${sc.vw} ${sc.vh}" role="img" aria-label="${R.n}">${sc.s}<g id="dmst"></g><g id="dml"></g><g id="dmh"></g></svg></div><div class="dmb"><div class="dmc"><i>📦</i><b id="dmn"></b></div><div class="dmt" id="dmt"></div></div></div>`,3);
 const svg=$('#dmr'),ptr=e=>{const m=svg.getScreenCTM();if(!m)return null;const p=new DOMPoint(e.clientX,e.clientY).matrixTransform(m.inverse());return[p.x,p.y]};
 const alive=()=>$('#dmr')===svg&&playing;
 const put=(id,pt)=>{
  const h=cAt(pt);
  if(h&&h.inside){const c=h.c,used=new Set(inC(c.id).map(q=>q[7])),k=[...Array(c.cap).keys()].find(i=>!used.has(i));
   if(k===undefined){const tw=CP.find(o=>o.S===c.S&&o!==c&&o.t==='door'&&c.t==='door');msg(tw&&!op.has(tw.id)?'Plus de place de ce côté : ouvre l’autre porte.':'Plus de place ici.');sfx(260,.2);return false}
   const s0=c.g.slots[k];placed.push([id,+s0[0].toFixed(1),+s0[1].toFixed(1),c.g.an,1,c.k,c.id,k]);selId=null;msg('');sfx(520,.2);vib(8);bad.delete(id);layer();tray();placed.forEach(q=>q[4]=0);sv();
   if(!left().length)setTimeout(()=>{if(alive())verify()},350);return true}
  if(h&&h.closed&&DIT[id][2].includes(h.c.k)){msg(h.c.t==='door'?'C’est fermé : touche la porte pour l’ouvrir.':'Touche le tiroir pour l’ouvrir.');return false}
  const z=[...sc.zs].reverse().find(z=>dIn(pt,z.hull));
  if(!z){msg('Pose-le dans la pièce.');return false}
  const a=dClamp(pt,z.top);placed.push([id,+a[0].toFixed(1),+a[1].toFixed(1),z.a,1,z.k]);selId=null;msg('');sfx(520,.2);vib(8);bad.delete(id);layer();tray();placed.forEach(q=>q[4]=0);sv();
  if(!left().length)setTimeout(()=>{if(alive())verify()},350);
  return true;
 };
 /* fin de niveau : on regarde si chaque objet est au bon endroit */
 const okAt=q=>{let k=q[5];if(!k){const z=[...sc.zs].reverse().find(z=>dIn([q[1],q[2]],z.hull));k=z&&z.k}return!k||DIT[q[0]][2].includes(k)};
 const verify=()=>{if(left().length||done)return;bad=new Set(placed.filter(q=>!okAt(q)).map(q=>q[0]));placed.forEach(q=>{if(bad.has(q[0])&&q[6])op.add(q[6])});layer();tray();
  if(bad.size){msg(bad.size>1?bad.size+' objets ne sont pas au bon endroit : touche-les pour les replacer.':'Un objet n’est pas au bon endroit : touche-le pour le replacer.');vib(14);sfx(260,.25);return}
  done=true;confetti($('#dmr'));setTimeout(()=>{if(alive())win()},900)};
 /* toucher ou glisser */
 let dr=null;
 const ghost=(id,x,y)=>{let g=$('#dmg');if(!g){g=document.createElement('div');g.id='dmg';g.className='dmg';document.body.appendChild(g)}g.innerHTML=dSpr(id,40);g.style.left=x+'px';g.style.top=y+'px'};
 const noGhost=()=>{const g=$('#dmg');if(g)g.remove()};
 const tt=$('#dmt');
 const mvH=e=>{if(!dr)return;if(!dr.mv&&Math.hypot(e.clientX-dr.x,e.clientY-dr.y)>8){dr.mv=true;selId=dr.id;tt.querySelectorAll('.dmi').forEach(b=>b.classList.toggle('sel',b.dataset.id===selId))}if(dr.mv)ghost(dr.id,e.clientX,e.clientY)};
 const up=e=>{document.removeEventListener('pointermove',mvH);document.removeEventListener('pointerup',up);document.removeEventListener('pointercancel',cn);if(!dr)return;const d=dr;dr=null;noGhost();
  if(d.mv){const r0=svg.getBoundingClientRect();if(e.clientX>=r0.left&&e.clientX<=r0.right&&e.clientY>=r0.top&&e.clientY<=r0.bottom){const p=ptr(e);if(p&&!put(d.id,p)){selId=null;tray()}}else{selId=null;tray()}}
  else{selId=selId===d.id?null:d.id;tray();msg(selId?'Touche l’endroit où le ranger.':'')}};
 const cn=()=>{document.removeEventListener('pointermove',mvH);document.removeEventListener('pointerup',up);document.removeEventListener('pointercancel',cn);dr=null;noGhost()};
 tt.addEventListener('pointerdown',e=>{const b=e.target.closest('.dmi');if(!b)return;dr={id:b.dataset.id,x:e.clientX,y:e.clientY,mv:false};document.addEventListener('pointermove',mvH);document.addEventListener('pointerup',up);document.addEventListener('pointercancel',cn)});
 svg.addEventListener('pointerdown',e=>{const s=e.target.closest&&e.target.closest('.dmp.bad');if(!s||dr)return;e.preventDefault();const id=s.dataset.id,k=placed.findIndex(q=>q[0]===id);if(k<0)return;placed.splice(k,1);bad.delete(id);selId=null;layer();tray();sv();dr={id,x:e.clientX,y:e.clientY,mv:false};document.addEventListener('pointermove',mvH);document.addEventListener('pointerup',up);document.addEventListener('pointercancel',cn)});
 svg.addEventListener('pointerup',e=>{if(dr)return;const p=ptr(e);if(!p)return;const h=cAt(p);
  if(h&&h.closed){toggle(h.c,true);msg(selId?'':(h.c.t==='door'?'La porte est ouverte.':'Le tiroir est ouvert.'));return}
  if(h&&h.panel&&!selId){toggle(h.c,false);msg('');return}
  if(selId)put(selId,p)});
 act.hint=()=>{const id=selId||left()[0]||[...bad][0];if(!id||!spend(3))return;const h=$('#dmh');if(!h)return;h.innerHTML=sc.zs.filter(z=>DIT[id][2].includes(z.k)&&z.k!=='wall'&&z.k!=='floor'||DIT[id][2].includes(z.k)&&(z.k==='wall'||z.k==='floor')).map(z=>`<polygon class="dmhz" points="${z.hull.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ')}"/>`).join('')+CP.filter(c=>DIT[id][2].includes(c.k)).map(c=>`<polygon class="dmhz" points="${f2(op.has(c.id)?c.g.zone:c.g.front)}"/>`).join('');msg(`Indice : « ${DIT[id][0]} » se range sur la zone qui brille.`);clearTimeout(hintT);hintT=setTimeout(()=>{const g=$('#dmh');if(g)g.innerHTML=''},3200)};
 layer();tray();
 if(!r&&!X&&dStory[lv]&&!st.get(ckey('demenage')+':'+lv,false))dmOv(`<small>${dStory[lv][0]}</small><p class="sfq">${dStory[lv][1]}</p>`,'Ouvrir les boîtes');
 else if(!r&&!left().length)setTimeout(()=>{if(alive())win()},300);
 if(r&&!left().length)setTimeout(()=>{if(alive())verify()},400);
}
