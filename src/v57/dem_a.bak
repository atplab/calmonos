/* ---------- Déménagement : des pièces en perspective isométrique, des boîtes à vider ---------- */
const DU=21,DZ=24;
const dSh=(h,k)=>{const n=parseInt(h.slice(1),16),f=v=>Math.max(0,Math.min(255,Math.round(v*k)));return'#'+[n>>16,(n>>8)&255,n&255].map(f).map(v=>v.toString(16).padStart(2,'0')).join('')};
const dHull=a=>{const p=a.slice().sort((u,v)=>u[0]-v[0]||u[1]-v[1]),cr=(o,u,v)=>(u[0]-o[0])*(v[1]-o[1])-(u[1]-o[1])*(v[0]-o[0]),lo=[],up=[];for(const q of p){while(lo.length>1&&cr(lo[lo.length-2],lo[lo.length-1],q)<=0)lo.pop();lo.push(q)}for(const q of p.reverse()){while(up.length>1&&cr(up[up.length-2],up[up.length-1],q)<=0)up.pop();up.push(q)}return lo.slice(0,-1).concat(up.slice(0,-1))};
const dIn=(p,a)=>{let c=false;for(let i=0,j=a.length-1;i<a.length;j=i++){const[xi,yi]=a[i],[xj,yj]=a[j];if((yi>p[1])!==(yj>p[1])&&p[0]<(xj-xi)*(p[1]-yi)/(yj-yi)+xi)c=!c}return c};
const dCen=a=>[a.reduce((s,p)=>s+p[0],0)/a.length,a.reduce((s,p)=>s+p[1],0)/a.length];
/* ramène un point à l’intérieur d’un polygone (vers son centre) */
const dClamp=(p,a)=>{if(dIn(p,a))return p;const c=dCen(a);let q=p;for(let i=0;i<24&&!dIn(q,a);i++)q=[q[0]+(c[0]-q[0])*.15,q[1]+(c[1]-q[1])*.15];return q};
function dNew(W,D,Hh,wl,wr,fl,fl2){
 const OX=D*DU+18,OY=Hh*DZ+18,P=(x,y,z=0)=>[OX+(x-y)*DU,OY+(x+y)*DU/2-z*DZ],f1=a=>a.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
 const o={P,W,D,Hh,s:'',zs:[],vw:Math.round((W+D)*DU+36),vh:Math.round(Hh*DZ+(W+D)*DU/2+44)};
 o.pg=(a,f,st,w)=>{o.s+=`<polygon points="${f1(a)}" fill="${f}"${st?` stroke="${st}" stroke-width="${w||.8}" stroke-linejoin="round"`:''}/>`};
 o.ln=(a,b,c,w)=>{o.s+=`<line x1="${a[0].toFixed(1)}" y1="${a[1].toFixed(1)}" x2="${b[0].toFixed(1)}" y2="${b[1].toFixed(1)}" stroke="${c}" stroke-width="${w||1}" stroke-linecap="round"/>`};
 /* socle du décor et sol */
 o.pg([P(0,D),P(W,D),P(W,D,-.4),P(0,D,-.4)],dSh(fl,.72));o.pg([P(W,0),P(W,D),P(W,D,-.4),P(W,0,-.4)],dSh(fl,.56));
 o.pg([P(0,0),P(W,0),P(W,D),P(0,D)],fl);
 if(fl2)for(let i=0;i<W;i++)for(let j=0;j<D;j++)if((i+j)%2)o.pg([P(i,j),P(i+1,j),P(i+1,j+1),P(i,j+1)],fl2);
 o.pg([P(0,0),P(0,D),P(0,D,Hh),P(0,0,Hh)],wl);o.pg([P(0,0),P(W,0),P(W,0,Hh),P(0,0,Hh)],wr);
 o.pg([P(0,D,0),P(-.35,D,0),P(-.35,D,Hh),P(0,D,Hh)],dSh(wl,.62));o.pg([P(W,0,0),P(W,-.35,0),P(W,-.35,Hh),P(W,0,Hh)],dSh(wr,.6));
 o.pg([P(0,0,Hh),P(0,D,Hh),P(-.35,D,Hh),P(-.35,0,Hh)],dSh(wl,.8));o.pg([P(0,0,Hh),P(W,0,Hh),P(W,-.35,Hh),P(0,-.35,Hh)],dSh(wr,.8));
 o.ln(P(0,0,0),P(0,0,Hh),dSh(wl,.6),1.4);
 o.qL=(y0,y1,z0,z1)=>[P(0,y0,z0),P(0,y1,z0),P(0,y1,z1),P(0,y0,z1)];
 o.qR=(x0,x1,z0,z1)=>[P(x0,0,z0),P(x1,0,z0),P(x1,0,z1),P(x0,0,z1)];
 o.zone=(k,top,hull,anchor)=>{o.zs.push({k,top,hull:hull||top,a:anchor||'b'})};
 o.zone('floor',[P(0,0),P(W,0),P(W,D),P(0,D)],null,'b');
 o.zone('wall',o.qL(0,D,.2,Hh-.2),null,'c');o.zone('wall',o.qR(0,W,.2,Hh-.2),null,'c');
 /* un pavé : dessus, face gauche (côté +y), face droite (côté +x) */
 o.box=(x,y,z,w,d,h,c,opt={})=>{
  const T=[P(x,y,z+h),P(x+w,y,z+h),P(x+w,y+d,z+h),P(x,y+d,z+h)],Lf=[P(x,y+d,z),P(x+w,y+d,z),P(x+w,y+d,z+h),P(x,y+d,z+h)],Rf=[P(x+w,y,z),P(x+w,y+d,z),P(x+w,y+d,z+h),P(x+w,y,z+h)],st=opt.st||dSh(c,.62);
  if(!opt.noL)o.pg(Lf,opt.l||c,st);if(!opt.noR)o.pg(Rf,opt.r||dSh(c,.8),st);o.pg(T,opt.t||dSh(c,1.12),st);
  return{top:T,hull:dHull([...T,...Lf,...Rf]),L:Lf,R:Rf};
 };
 /* un cylindre (pot, cuvette) vu de dessus */
 o.cyl=(x,y,z,r,h,c)=>{const[cx,cy]=P(x,y,z),rx=r*DU*1.41,ry=rx/2,hh=h*DZ;o.s+=`<path d="M${(cx-rx).toFixed(1)} ${cy.toFixed(1)}v${-hh.toFixed(1)}a${rx.toFixed(1)} ${ry.toFixed(1)} 0 0 1 ${(2*rx).toFixed(1)} 0v${hh.toFixed(1)}a${rx.toFixed(1)} ${ry.toFixed(1)} 0 0 1 ${(-2*rx).toFixed(1)} 0z" fill="${c}" stroke="${dSh(c,.62)}" stroke-width=".8"/><ellipse cx="${cx.toFixed(1)}" cy="${(cy-hh).toFixed(1)}" rx="${rx.toFixed(1)}" ry="${ry.toFixed(1)}" fill="${dSh(c,1.12)}" stroke="${dSh(c,.62)}" stroke-width=".8"/>`};
 return o;
}
