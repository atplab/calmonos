rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profils (Social) : chacun n'écrit que le sien. On ne peut lire qu'un profil dont on connaît l'identifiant
    // (jamais toute la liste), ce qui limite les lectures et empêche de tout aspirer.
    match /profiles/{uid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['j'])
        && request.resource.data.j is string
        && request.resource.data.j.size() < 60000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Codes amis : codes/<CODE> = { u: identifiant }. Lecture un par un seulement ; chacun ne peut écrire que son propre code.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && code.matches('[A-HJKMNP-Z2-9]{8}')
        && request.resource.data.keys().hasOnly(['u'])
        && request.resource.data.u == request.auth.uid
        && (resource == null || resource.data.u == request.auth.uid);
    }

    // Boîte d'arrivée : inbox/<destinataire> = { <expéditeur>: 1 } indique qui m'a ajouté ou m'a offert un cadeau.
    // Seul le destinataire la lit ; chaque expéditeur n'écrit que sa propre clé.
    match /inbox/{rcpt} {
      allow get: if request.auth != null && request.auth.uid == rcpt;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([request.auth.uid])
        && request.resource.data[request.auth.uid] == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data[request.auth.uid] == 1;
    }

    // Parties de Scrabble : sc/<uid1>_<uid2> (identifiants triés). Seuls les deux joueurs lisent et écrivent leur partie.
    match /sc/{gid} {
      allow get: if request.auth != null && request.auth.uid in gid.split('_');
      allow create, update: if request.auth != null && request.auth.uid in gid.split('_')
        && request.resource.data.keys().hasOnly(['j'])
        && request.resource.data.j is string
        && request.resource.data.j.size() < 20000;
    }

    // Achats de flocons : écrits seulement par le serveur (webhook Stripe). Le joueur lit son propre total.
    match /buys/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /s/{sid} { allow read, write: if false; }
    }

    // Sauvegarde par compte : strictement privée.
    match /data/users/{uid}/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['j'])
        && request.resource.data.j is string
        && request.resource.data.j.size() < 200000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Classements du mode infini : lb/<plateau>/e/<uid> = { s: score, n: pseudo, t: date }. Chacun n'écrit que sa ligne ;
    // la lecture se fait par liste de 30 au plus (les meilleurs).
    match /lb/{board}/e/{uid} {
      allow get: if request.auth != null && board in ['g2048','tetris','pc','po','pu','ca','bl'];
      allow list: if request.auth != null && board in ['g2048','tetris','pc','po','pu','ca','bl'] && request.query.limit <= 30;
      allow create, update: if request.auth != null && request.auth.uid == uid && board in ['g2048','tetris','pc','po','pu','ca','bl']
        && request.resource.data.keys().hasOnly(['s','n','t'])
        && request.resource.data.s is int && request.resource.data.s > 0 && request.resource.data.s <= 10000000
        && request.resource.data.n is string && request.resource.data.n.size() <= 24
        && request.resource.data.t is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
